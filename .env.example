# Copy to .env.local for a local preview. Never commit passwords.
CONTACT_MODE=preview
# In production use a random secret shared by all instances (at least 32 characters).
CONTACT_SECRET=
CONTACT_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM=
CONTACT_TO=
